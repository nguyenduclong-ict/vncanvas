{
  "name": "vietnamcanvas",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "generate-pwa-assets": "pwa-assets-generator public/logo.svg --preset minimal",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply vietnam-canvas-db --local",
    "db:seed": "wrangler d1 execute vietnam-canvas-db --local --file=./db/seed.sql",
    "db:studio": "drizzle-kit studio",
    "import:destinations": "npx tsx scripts/import_destinations.ts",
    "create-admin": "npx tsx scripts/create_admin.ts",
    "build:api": "BUILD_TARGET=api nuxt build --dotenv .env.prod",
    "deploy:api": "wrangler --config wrangler.worker.toml deploy",
    "generate": "BUILD_TARGET=static nuxt generate --dotenv .env.prod",
    "deploy:static": "wrangler pages deploy dist"
  },
  "dependencies": {
    "@google/genai": "^1.34.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^25.0.3",
    "@vueuse/nuxt": "^14.1.0",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.1.2",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.1",
    "gsap": "^3.14.2",
    "jose": "^6.1.3",
    "lucide-vue-next": "^0.562.0",
    "nuxt": "^4.2.2",
    "vue": "^3.5.26",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@nuxtjs/i18n": "^10.2.1",
    "@nuxtjs/seo": "^3.3.0",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@vite-pwa/assets-generator": "^1.0.2",
    "drizzle-kit": "^0.31.8",
    "sass": "^1.97.1",
    "wrangler": "^4.54.0"
  }
}

{
  "name": "vietnamcanvas",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "generate-pwa-assets": "pwa-assets-generator public/logo.svg --preset minimal",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply vietnam-canvas-db --local",
    "db:seed": "wrangler d1 execute vietnam-canvas-db --local --file=./db/seed.sql",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@vueuse/nuxt": "^14.1.0",
    "drizzle-orm": "^0.45.1",
    "gsap": "^3.14.2",
    "lucide-vue-next": "^0.562.0",
    "nuxt": "^4.2.2",
    "vue": "^3.5.26",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@nuxtjs/i18n": "^10.2.1",
    "@nuxtjs/seo": "^3.3.0",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@vite-pwa/assets-generator": "^1.0.2",
    "drizzle-kit": "^0.31.8",
    "sass": "^1.97.1",
    "wrangler": "^4.54.0"
  }
}
